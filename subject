<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SAFELINE — Digital Crime Awareness Portal</title>
  <meta name="description" content="SAFELINE — A student-built portal to learn about phishing, UPI/OTP fraud, ransomware, identity theft and how to report cybercrime in India.">
  <meta name="theme-color" content="#0B1E3D">
  <link rel="icon" href="/favicon.ico" type="image/x-icon">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <style>
    :root{
      --ink:#0B1E3D;
      --ink-2:#122a52;
      --paper:#F5F6F8;
      --paper-2:#ffffff;
      --slate:#1C2333;
      --mute:#5b6478;
      --cyan:#2DD4C8;
      --amber:#F2A93B;
      --red:#E4573D;
      --line:rgba(11,30,61,0.12);
      --line-dark:rgba(255,255,255,0.14);
    }
    *{box-sizing:border-box; margin:0; padding:0;}
    html{scroll-behavior:smooth;}
    body{
      font-family:'IBM Plex Sans', sans-serif;
      background:var(--paper);
      color:var(--slate);
      line-height:1.6;
      -webkit-font-smoothing:antialiased;
    }
    h1,h2,h3,h4{font-family:'Space Grotesk', sans-serif; letter-spacing:-0.01em;}
    .mono{font-family:'IBM Plex Mono', monospace;}
    a{color:inherit;}
    img,svg{display:block; max-width:100%;}
    .wrap{max-width:1120px; margin:0 auto; padding:0 24px;}
    ::selection{background:var(--cyan); color:var(--ink);}

    /* ---------- Skip link / focus ---------- */
    .skip-link{position:absolute; left:-999px; top:0; background:var(--cyan); color:var(--ink); padding:10px 16px; z-index:999; font-weight:600;}
    .skip-link:focus{left:12px; top:12px;}
    a:focus-visible, button:focus-visible, .nav-link:focus-visible{outline:2px solid var(--cyan); outline-offset:3px;}

    /* ---------- Nav ---------- */
    header.site-nav{
      position:sticky; top:0; z-index:100;
      background:rgba(11,30,61,0.96);
      backdrop-filter:blur(8px);
      border-bottom:1px solid var(--line-dark);
    }
    .nav-inner{
      max-width:1120px; margin:0 auto; padding:14px 24px;
      display:flex; align-items:center; justify-content:space-between;
    }
    .brand{display:flex; align-items:center; gap:10px; color:#fff; font-weight:700; font-size:1.1rem;}
    .brand-mark{
      width:30px; height:30px; border-radius:7px;
      background:linear-gradient(135deg, var(--cyan), #1a9d94);
      display:flex; align-items:center; justify-content:center;
      color:var(--ink); font-family:'IBM Plex Mono',monospace; font-weight:700; font-size:0.85rem;
    }
    nav.links{display:flex; gap:28px; align-items:center;}
    .nav-link{
      color:rgba(255,255,255,0.72); text-decoration:none; font-size:0.92rem; font-weight:500;
      padding:6px 2px; border-bottom:2px solid transparent; transition:color .2s, border-color .2s;
    }
    .nav-link:hover{color:#fff; border-color:var(--cyan);}
    .report-btn{
      background:var(--amber); color:var(--ink); padding:9px 16px; border-radius:6px;
      font-weight:600; font-size:0.88rem; text-decoration:none; white-space:nowrap;
    }
    .menu-toggle{display:none; background:none; border:none; color:#fff; font-size:1.4rem; cursor:pointer;}
    @media (max-width:860px){
      nav.links{position:fixed; top:62px; left:0; right:0; background:var(--ink); flex-direction:column; align-items:flex-start; padding:18px 24px; gap:16px; transform:translateY(-130%); transition:transform .25s ease; border-bottom:1px solid var(--line-dark);}
      nav.links.open{transform:translateY(0);}
      .menu-toggle{display:block;}
    }

    /* ---------- Hero ---------- */
    .hero{
      background:
        radial-gradient(ellipse at 80% -10%, rgba(45,212,200,0.18), transparent 55%),
        linear-gradient(180deg, var(--ink) 0%, var(--ink-2) 100%);
      color:#fff; position:relative; overflow:hidden;
      padding:88px 0 76px;
      border-bottom:1px solid var(--line-dark);
    }
    .hero::before{
      content:""; position:absolute; inset:0;
      background-image:
        linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
      background-size:42px 42px;
      mask-image:radial-gradient(ellipse at 70% 20%, black, transparent 70%);
    }
    .hero-inner{position:relative; display:grid; grid-template-columns:1.15fr 0.85fr; gap:48px; align-items:center;}
    @media (max-width:900px){.hero-inner{grid-template-columns:1fr;}}
    .eyebrow-tag{
      display:inline-flex; align-items:center; gap:8px;
      font-family:'IBM Plex Mono',monospace; font-size:0.76rem; letter-spacing:0.08em;
      color:var(--cyan); background:rgba(45,212,200,0.1); border:1px solid rgba(45,212,200,0.35);
      padding:6px 12px; border-radius:100px; margin-bottom:22px;
    }
    .eyebrow-tag .dot{width:6px; height:6px; border-radius:50%; background:var(--cyan); box-shadow:0 0 8px var(--cyan);}
    .hero h1{font-size:clamp(2.1rem, 4.4vw, 3.4rem); line-height:1.08; margin-bottom:20px; font-weight:700;}
    .hero h1 span{color:var(--cyan);}
    .hero p.lede{font-size:1.08rem; color:rgba(255,255,255,0.72); max-width:52ch; margin-bottom:30px;}
    .hero-ctas{display:flex; gap:14px; flex-wrap:wrap;}
    .btn-primary{
      background:var(--cyan); color:var(--ink); padding:13px 24px; border-radius:7px;
      font-weight:600; text-decoration:none; font-size:0.95rem; display:inline-flex; align-items:center; gap:8px;
      transition:transform .15s ease;
    }
    .btn-primary:hover{transform:translateY(-2px);}
    .btn-ghost{
      border:1px solid rgba(255,255,255,0.28); color:#fff; padding:13px 24px; border-radius:7px;
      font-weight:600; text-decoration:none; font-size:0.95rem;
    }
    .btn-ghost:hover{border-color:var(--cyan); color:var(--cyan);}

    /* Case board visual */
    .case-board{
      position:relative; background:rgba(255,255,255,0.04); border:1px solid var(--line-dark);
      border-radius:14px; padding:22px; backdrop-filter:blur(4px);
    }
    .case-board .cb-head{display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; font-family:'IBM Plex Mono',monospace; font-size:0.72rem; color:rgba(255,255,255,0.5); letter-spacing:0.06em;}
    .cb-row{display:flex; justify-content:space-between; align-items:center; padding:11px 4px; border-bottom:1px dashed var(--line-dark); font-size:0.88rem;}
    .cb-row:last-child{border-bottom:none;}
    .cb-name{color:#fff; font-weight:500;}
    .threat{font-family:'IBM Plex Mono',monospace; font-size:0.68rem; font-weight:600; padding:3px 9px; border-radius:100px; letter-spacing:0.04em;}
    .threat.high{background:rgba(228,87,61,0.16); color:#ff8a72;}
    .threat.critical{background:rgba(228,87,61,0.26); color:#ff6a4d;}
    .threat.medium{background:rgba(242,169,59,0.18); color:var(--amber);}

    /* ---------- Section shared ---------- */
    section{padding:80px 0;}
    .section-head{max-width:640px; margin-bottom:44px;}
    .section-eyebrow{
      font-family:'IBM Plex Mono',monospace; font-size:0.76rem; letter-spacing:0.09em; text-transform:uppercase;
      color:var(--red); font-weight:600; margin-bottom:10px; display:block;
    }
    .section-head h2{font-size:clamp(1.7rem,3vw,2.3rem); margin-bottom:14px;}
    .section-head p{color:var(--mute); font-size:1.02rem;}
    #cybercrimes{background:var(--paper-2); border-top:1px solid var(--line); border-bottom:1px solid var(--line);}

    /* ---------- Case files grid ---------- */
    .file-grid{display:grid; grid-template-columns:repeat(3,1fr); gap:20px;}
    @media (max-width:900px){.file-grid{grid-template-columns:repeat(2,1fr);}}
    @media (max-width:640px){.file-grid{grid-template-columns:1fr;}}
    .file-card{
      background:var(--paper); border:1px solid var(--line); border-radius:12px; padding:22px;
      display:flex; flex-direction:column; gap:12px; transition:transform .18s ease, box-shadow .18s ease;
      cursor:pointer;
    }
    .file-card:hover{transform:translateY(-4px); box-shadow:0 14px 30px rgba(11,30,61,0.09);}
    .file-top{display:flex; justify-content:space-between; align-items:flex-start;}
    .file-num{font-family:'IBM Plex Mono',monospace; font-size:0.72rem; color:var(--mute);}
    .file-icon{width:38px; height:38px; border-radius:9px; display:flex; align-items:center; justify-content:center; font-size:1.15rem; background:var(--ink); color:var(--cyan); flex-shrink:0;}
    .file-card h3{font-size:1.12rem; margin:2px 0 2px;}
    .file-card p{font-size:0.9rem; color:var(--mute);}
    .file-card .expand{display:none; font-size:0.88rem; color:var(--slate); border-top:1px solid var(--line); margin-top:6px; padding-top:12px;}
    .file-card.open .expand{display:block;}
    .file-card .toggle-hint{font-family:'IBM Plex Mono',monospace; font-size:0.72rem; color:var(--red); margin-top:auto;}
    .file-card ul{margin:8px 0 0 18px;}
    .file-card li{margin-bottom:5px;}
    .scenario{background:rgba(11,30,61,0.04); border-left:3px solid var(--amber); padding:10px 12px; margin-top:10px; font-size:0.87rem; border-radius:0 6px 6px 0;}

    /* ---------- Safety practices ---------- */
    .practice-grid{display:grid; grid-template-columns:repeat(4,1fr); gap:16px;}
    @media (max-width:900px){.practice-grid{grid-template-columns:repeat(2,1fr);}}
    @media (max-width:560px){.practice-grid{grid-template-columns:1fr;}}
    .practice-card{background:var(--ink); color:#fff; border-radius:12px; padding:20px; }
    .practice-card .n{font-family:'IBM Plex Mono',monospace; color:var(--cyan); font-size:0.78rem; margin-bottom:10px; display:block;}
    .practice-card h4{font-size:1rem; margin-bottom:8px;}
    .practice-card p{font-size:0.86rem; color:rgba(255,255,255,0.68);}

    /* ---------- Laws ---------- */
    #laws{background:var(--paper-2); border-top:1px solid var(--line); border-bottom:1px solid var(--line);}
    .law-list{display:flex; flex-direction:column; border:1px solid var(--line); border-radius:12px; overflow:hidden;}
    .law-row{display:grid; grid-template-columns:140px 1fr; gap:20px; padding:20px 22px; border-bottom:1px solid var(--line); background:var(--paper);}
    .law-row:last-child{border-bottom:none;}
    .law-row:nth-child(even){background:var(--paper-2);}
    @media (max-width:640px){.law-row{grid-template-columns:1fr; gap:6px;}}
    .law-code{font-family:'IBM Plex Mono',monospace; font-weight:600; color:var(--ink); font-size:0.95rem;}
    .law-desc h4{font-size:0.98rem; margin-bottom:4px;}
    .law-desc p{font-size:0.88rem; color:var(--mute);}

    /* ---------- Reporting ---------- */
    .report-panel{
      background:linear-gradient(135deg, var(--ink), var(--ink-2)); color:#fff; border-radius:16px; padding:40px;
      display:grid; grid-template-columns:1fr 1fr; gap:40px;
    }
    @media (max-width:860px){.report-panel{grid-template-columns:1fr; padding:28px;}}
    .helpline{background:rgba(45,212,200,0.1); border:1px solid rgba(45,212,200,0.35); border-radius:12px; padding:22px; margin-bottom:22px;}
    .helpline .big{font-family:'IBM Plex Mono',monospace; font-size:2.2rem; color:var(--cyan); font-weight:600; letter-spacing:0.03em;}
    .steps{counter-reset:step;}
    .step{display:flex; gap:14px; margin-bottom:18px;}
    .step .num{counter-increment:step; content:counter(step);}
    .step .num::before{content:counter(step,decimal-leading-zero); font-family:'IBM Plex Mono',monospace; color:var(--cyan); font-size:0.85rem; border:1px solid rgba(45,212,200,0.4); width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0;}
    .step p{font-size:0.9rem; color:rgba(255,255,255,0.75); padding-top:3px;}

    /* ---------- Case studies ---------- */
    #cases{background:var(--paper-2); border-top:1px solid var(--line); border-bottom:1px solid var(--line);}
    .study{display:grid; grid-template-columns:120px 1fr; gap:26px; padding:26px 0; border-bottom:1px solid var(--line); align-items:flex-start;}
    .study:last-child{border-bottom:none;}
    @media (max-width:640px){.study{grid-template-columns:1fr;}}
    .study .tag{font-family:'IBM Plex Mono',monospace; font-size:0.72rem; color:var(--red); font-weight:600;}
    .study h3{margin:6px 0 10px; font-size:1.15rem;}
    .study p{color:var(--mute); font-size:0.94rem; margin-bottom:10px;}
    .lesson{font-size:0.88rem; background:rgba(45,212,200,0.08); border:1px solid rgba(45,212,200,0.3); padding:10px 14px; border-radius:8px; display:inline-block;}
    .disclaimer-note{font-size:0.8rem; color:var(--mute); margin-top:28px; font-style:italic;}

    /* ---------- Anatomy diagram ---------- */
    .anatomy{background:var(--paper); border:1px solid var(--line); border-radius:14px; padding:28px; position:relative;}
    .mail-mock{background:var(--paper-2); border:1px solid var(--line); border-radius:10px; overflow:hidden; max-width:560px; margin:0 auto;}
    .mail-head{padding:14px 18px; border-bottom:1px solid var(--line); font-size:0.85rem;}
    .mail-head .flag{color:var(--red); font-weight:600; font-family:'IBM Plex Mono',monospace; font-size:0.72rem;}
    .mail-body{padding:18px; font-size:0.9rem;}
    .flag-item{display:flex; gap:10px; align-items:flex-start; margin-top:14px; padding:10px 12px; background:rgba(228,87,61,0.06); border-left:3px solid var(--red); border-radius:0 6px 6px 0; font-size:0.85rem;}

    /* ---------- Prevention checklist ---------- */
    #prevention{}
    .check-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:14px;}
    @media (max-width:640px){.check-grid{grid-template-columns:1fr;}}
    .check-item{display:flex; gap:14px; align-items:flex-start; background:var(--paper-2); border:1px solid var(--line); border-radius:10px; padding:16px 18px;}
    .check-item .mark{width:22px; height:22px; border-radius:6px; background:var(--cyan); color:var(--ink); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:0.8rem; font-weight:700; margin-top:2px;}
    .check-item h4{font-size:0.95rem; margin-bottom:3px;}
    .check-item p{font-size:0.85rem; color:var(--mute);}

    /* ---------- Footer ---------- */
    footer{background:var(--ink); color:rgba(255,255,255,0.7); padding:50px 0 30px;}
    .foot-grid{display:grid; grid-template-columns:1.4fr 1fr 1fr; gap:36px; margin-bottom:36px;}
    @media (max-width:700px){.foot-grid{grid-template-columns:1fr;}}
    footer h5{color:#fff; font-size:0.85rem; margin-bottom:14px; font-family:'IBM Plex Mono',monospace; letter-spacing:0.05em;}
    footer ul{list-style:none;}
    footer li{margin-bottom:9px; font-size:0.88rem;}
    footer a{text-decoration:none; color:rgba(255,255,255,0.68);}
    footer a:hover{color:var(--cyan);}
    .foot-bottom{border-top:1px solid var(--line-dark); padding-top:22px; font-size:0.8rem; color:rgba(255,255,255,0.45); display:flex; justify-content:space-between; flex-wrap:wrap; gap:10px;}

    /* reveal animation */
    .reveal{opacity:0; transform:translateY(18px); transition:opacity .6s ease, transform .6s ease;}
    .reveal.in{opacity:1; transform:none;}
    @media (prefers-reduced-motion: reduce){
      .reveal{opacity:1; transform:none; transition:none;}
      html{scroll-behavior:auto;}
    }
  </style>
</head>
<body>
  <a href="#main" class="skip-link">Skip to content</a>

  <header class="site-nav" role="banner">
    <div class="nav-inner">
      <div class="brand"><span class="brand-mark">SL</span> SAFELINE</div>
      <nav class="links" id="navLinks" role="navigation" aria-label="Primary">
        <a class="nav-link" href="#cybercrimes">Cybercrimes</a>
        <a class="nav-link" href="#practices">Safety Practices</a>
        <a class="nav-link" href="#laws">Cyber Laws</a>
        <a class="nav-link" href="#cases">Case Studies</a>
        <a class="nav-link" href="#prevention">Prevention</a>
        <a class="report-btn" href="#report">Report a Crime</a>
      </nav>
      <button class="menu-toggle" id="menuToggle" aria-label="Toggle navigation" aria-controls="navLinks" aria-expanded="false">☰</button>
    </div>
  </header>

  <main id="main" role="main">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-inner">
        <div>
          <span class="eyebrow-tag"><span class="dot"></span> FSC557 · DIGITAL AWARENESS PROJECT</span>
          <h1>Know the crime.<br>Read the <span>case file</span>.<br>Stay ahead of it.</h1>
          <p class="lede">SAFELINE is a digital crime awareness portal built to help students and the public recognise cybercrime, understand Indian cyber law, and report incidents before damage is done.</p>
          <div class="hero-ctas">
            <a class="btn-primary" href="#cybercrimes">Browse the case files ↓</a>
            <a class="btn-ghost" href="#report">I need to report something</a>
          </div>
        </div>
        <div class="case-board" aria-hidden="false">
          <div class="cb-head"><span>OPEN CASE FILES</span><span>STATUS: ACTIVE</span></div>
          <div class="cb-row"><span class="cb-name">Phishing</span><span class="threat high">HIGH</span></div>
          <div class="cb-row"><span class="cb-name">UPI / OTP Fraud</span><span class="threat critical">CRITICAL</span></div>
          <div class="cb-row"><span class="cb-name">Identity Theft</span><span class="threat high">HIGH</span></div>
          <div class="cb-row"><span class="cb-name">Ransomware</span><span class="threat critical">CRITICAL</span></div>
          <div class="cb-row"><span class="cb-name">Hacking</span><span class="threat high">HIGH</span></div>
          <div class="cb-row"><span class="cb-name">Cyberbullying</span><span class="threat medium">MEDIUM</span></div>
        </div>
      </div>
    </section>

    <!-- CYBERCRIMES -->
    <section id="cybercrimes">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="section-eyebrow">Case Files 001–006</span>
          <h2>Six cybercrimes you're most likely to encounter</h2>
          <p>Tap a file to open it. Each one covers how the crime works, the warning signs, and a realistic scenario.</p>
        </div>
        <div class="file-grid" id="fileGrid" aria-live="polite"></div>
      </div>
    </section>

    <!-- SAFETY PRACTICES -->
    <section id="practices">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="section-eyebrow">Field Guide</span>
          <h2>Everyday safety practices</h2>
          <p>Small habits that close most of the doors attackers rely on.</p>
        </div>
        <div class="practice-grid" id="practiceGrid"></div>
      </div>
    </section>

    <!-- LAWS -->
    <section id="laws">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="section-eyebrow">Statute Library</span>
          <h2>Cyber laws in India</h2>
          <p>The core legal provisions that define and penalise cybercrime — good to know if you're a victim, and a warning if you're not.</p>
        </div>
        <div class="law-list reveal" id="lawList" aria-hidden="false"></div>
      </div>
    </section>

    <!-- REPORT -->
    <section id="report">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="section-eyebrow">Response Protocol</span>
          <h2>How to report a cybercrime</h2>
          <p>Act fast — the first hour after a financial fraud matters most for recovering funds.</p>
        </div>
        <div class="report-panel reveal">
          <div>
            <div class="helpline" role="region" aria-label="National helpline">
              <div style="font-family:'IBM Plex Mono',monospace; font-size:0.75rem; color:rgba(255,255,255,0.6); margin-bottom:6px;">NATIONAL CYBER CRIME HELPLINE</div>
              <div class="big">1930</div>
              <p style="font-size:0.85rem; color:rgba(255,255,255,0.7); margin-top:8px;">Call immediately to report financial cyber fraud, or file online at the National Cyber Crime Reporting Portal.</p>
            </div>
            <p style="font-size:0.88rem; color:rgba(255,255,255,0.65);">Online complaints: <span class="mono" style="color:var(--cyan);">cybercrime.gov.in</span> — covers financial fraud, women/child-related crimes, hacking, and more. You can track your complaint status with the acknowledgement number issued.</p>
          </div>
          <div class="steps" id="stepsList" aria-hidden="false"></div>
        </div>
      </div>
    </section>

    <!-- CASE STUDIES -->
    <section id="cases">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="section-eyebrow">Field Reports</span>
          <h2>Illustrative case studies</h2>
          <p>Composite, anonymised scenarios based on common patterns reported across India — built to teach, not to identify anyone.</p>
        </div>
        <div id="studyList" aria-hidden="false"></div>
        <p class="disclaimer-note">Names, locations and identifying details in the scenarios above are fictional composites created for educational purposes and do not refer to real individuals or ongoing cases.</p>
      </div>
    </section>

    <!-- ANATOMY / INFOGRAPHIC -->
    <section id="anatomy-section">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="section-eyebrow">Visual Breakdown</span>
          <h2>Anatomy of a phishing message</h2>
          <p>Most phishing attempts share the same tells. Here's what to look for.</p>
        </div>
        <div class="anatomy reveal">
          <div class="mail-mock" aria-hidden="false">
            <div class="mail-head">
              <div class="flag">⚠ SENDER: support@secure-bank-verify.com</div>
              <div style="margin-top:6px;">Subject: Urgent — Your account will be suspended in 24 hours</div>
            </div>
            <div class="mail-body">
              Dear Customer,<br><br>
              We detected unusual activity. Click below to verify your account immediately or it will be permanently locked.<br><br>
              <span style="color:var(--cyan); text-decoration:underline;">Verify My Account →</span>
            </div>
          </div>
          <div style="max-width:560px; margin:0 auto;">
            <div class="flag-item">🚩 <span><strong>Mismatched sender domain</strong> — a real bank never emails from a generic or misspelled domain.</span></div>
            <div class="flag-item">🚩 <span><strong>Manufactured urgency</strong> — "24 hours" or "immediately" is designed to stop you thinking clearly.</span></div>
            <div class="flag-item">🚩 <span><strong>Generic greeting</strong> — "Dear Customer" instead of your actual name.</span></div>
            <div class="flag-item">🚩 <span><strong>Action-forcing link</strong> — hover before clicking; the visible text rarely matches the real URL.</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- PREVENTION -->
    <section id="prevention">
      <div class="wrap">
        <div class="section-head reveal">
          <span class="section-eyebrow">Checklist</span>
          <h2>Preventive measures worth adopting today</h2>
        </div>
        <div class="check-grid" id="checkGrid"></div>
      </div>
    </section>
  </main>

  <footer role="contentinfo">
    <div class="wrap">
      <div class="foot-grid">
        <div>
          <div class="brand" style="margin-bottom:12px;"><span class="brand-mark">SL</span> SAFELINE</div>
          <p style="font-size:0.86rem; max-width:34ch;">A digital crime awareness portal created as an academic project for FSC557, to help students and the public recognise, prevent, and report cybercrime.</p>
        </div>
        <div>
          <h5>PORTAL</h5>
          <ul>
            <li><a href="#cybercrimes">Cybercrime case files</a></li>
            <li><a href="#laws">Cyber laws</a></li>
            <li><a href="#cases">Case studies</a></li>
            <li><a href="#prevention">Prevention checklist</a></li>
          </ul>
        </div>
        <div>
          <h5>REPORT & RESOURCES</h5>
          <ul>
            <li><a href="https://cybercrime.gov.in" target="_blank" rel="noopener noreferrer">cybercrime.gov.in</a></li>
            <li>Helpline: 1930</li>
            <li>Emergency: 112</li>
          </ul>
        </div>
      </div>
      <div class="foot-bottom">
        <span>© 2026 SAFELINE — Student project, FSC557.</span>
        <span>Not affiliated with any government agency. For real emergencies, contact 1930 or 112 directly.</span>
      </div>
    </div>
  </footer>

  <script>
    // ---------- DATA ----------
    const cases = [
      {num:"FILE 001", icon:"🎣", threat:"HIGH", title:"Phishing", summary:"Fake emails, texts or calls that impersonate a trusted source to steal credentials or money.",
       details:["Attacker poses as a bank, delivery service, or employer to create urgency.","Victim is pushed toward a fake login page or asked to share an OTP/PIN.","Credentials or funds are stolen within minutes of the click."],
       scenario:"A student receives an SMS claiming their exam portal login has expired and must be 'reverified' via a link. The link opens a cloned page that captures their password."},
      {num:"FILE 002", icon:"💳", threat:"CRITICAL", title:"Online Fraud (UPI/OTP)", summary:"Fraudulent transactions carried out via fake payment requests, QR codes, or OTP sharing.",
       details:["Common on marketplace apps: 'buyer' sends a QR code that actually debits, not credits, money.","Fraudster impersonates customer care and asks for an OTP to 'process a refund'.","Money moves instantly and is very hard to reverse."],
       scenario:"Someone selling a used phone online receives a 'payment' QR from a buyer. Scanning it — instead of receiving money — silently deducts ₹15,000 from their account."},
      {num:"FILE 003", icon:"🪪", threat:"HIGH", title:"Identity Theft", summary:"Personal information (Aadhaar, PAN, photos, credentials) is stolen and used to impersonate the victim.",
       details:["Leaked data from breaches, phishing, or oversharing on social media is pieced together.","Stolen identity is used to open loans, SIM cards, or fraudulent accounts.","Victims often only discover it when a loan recovery call arrives."],
       scenario:"A person's Aadhaar copy, shared for a gym membership, resurfaces months later linked to a mobile connection they never applied for."},
      {num:"FILE 004", icon:"🔒", threat:"CRITICAL", title:"Ransomware", summary:"Malicious software that encrypts files or locks a device until a ransom is paid.",
       details:["Usually delivered via a malicious attachment, cracked software, or infected USB drive.","Files are encrypted silently; a ransom note appears demanding cryptocurrency.","Paying does not guarantee decryption — and funds further attacks."],
       scenario:"A college's admin computer is locked after a staff member opens an 'invoice.exe' attachment, encrypting years of student records."},
      {num:"FILE 005", icon:"🖥️", threat:"HIGH", title:"Hacking / Unauthorised Access", summary:"Gaining unauthorised entry into systems, accounts, or networks — often via weak passwords or unpatched software.",
       details:["Reused or weak passwords are the single biggest entry point.","Public Wi-Fi without a VPN can expose login sessions.","Once inside, attackers often move laterally to more valuable accounts."],
       scenario:"A reused college-email password (also used on a hacked forum) lets an attacker log into a student's email and reset their banking app password."},
      {num:"FILE 006", icon:"💬", threat:"MEDIUM", title:"Cyberbullying & Harassment", summary:"Repeated online abuse, threats, morphing of images, or stalking directed at a person.",
       details:["Includes trolling, morphed/circulated images, impersonation accounts, and persistent unwanted contact.","Often escalates from a single group chat or comment thread.","Platforms and law both provide reporting and takedown mechanisms."],
       scenario:"A student's photo is morphed and circulated in a class group chat after a public disagreement, followed by anonymous threatening messages."},
    ];

    const practices = [
      {n:"01", title:"Use unique passwords", body:"A different password per account, ideally via a password manager, stops one leak from cascading into every account."},
      {n:"02", title:"Turn on 2FA", body:"Two-factor authentication blocks most account takeovers even if your password is stolen."},
      {n:"03", title:"Never share OTPs", body:"No bank, company, or 'customer care' agent will ever legitimately ask for your OTP or PIN over call or chat."},
      {n:"04", title:"Verify before you click", body:"Hover over links, check sender domains, and go directly to official apps or sites instead of following links in messages."},
      {n:"05", title:"Limit what you share", body:"Aadhaar numbers, boarding passes, and ID photos posted online can be reassembled into a stolen identity."},
      {n:"06", title:"Update software promptly", body:"Security patches close the exact holes ransomware and hacking tools are built to exploit."},
      {n:"07", title:"Avoid public Wi-Fi for banking", body:"Unsecured networks let attackers intercept traffic; use mobile data or a trusted VPN for sensitive logins."},
      {n:"08", title:"Screenshot before you report", body:"Preserve messages, numbers, and transaction IDs immediately — evidence disappears fast once accounts are blocked."},
    ];

    const laws = [
      {code:"IT Act, Sec. 43", title:"Penalty for damage to computer systems", body:"Covers unauthorised access, data theft, or introducing viruses into a computer or network — the basis for most hacking-related complaints."},
      {code:"IT Act, Sec. 66", title:"Computer-related offences", body:"Criminal liability (imprisonment and/or fine) for dishonest or fraudulent acts covered under Section 43."},
      {code:"IT Act, Sec. 66C", title:"Identity theft", body:"Punishes fraudulent or dishonest use of another person's electronic signature, password, or unique identification."},
      {code:"IT Act, Sec. 66D", title:"Cheating by personation", body:"Specifically targets impersonation carried out using a computer resource or communication device — the core phishing and fraud provision."},
      {code:"IT Act, Sec. 66E", title:"Violation of privacy", body:"Covers capturing, publishing, or transmitting images of a person's private area without consent."},
      {code:"IT Act, Sec. 67 / 67A", title:"Obscene / sexually explicit content", body:"Penalises publishing or transmitting obscene material electronically, with enhanced penalties for sexually explicit content."},
      {code:"IPC Sec. 354D", title:"Stalking", body:"Extends to monitoring a person's internet, email, or electronic communication use without consent — used in online stalking cases."},
      {code:"DPDP Act, 2023", title:"Digital Personal Data Protection", body:"Governs how organisations must collect, process, and secure personal data, and gives individuals rights over their own data."},
    ];

    const stepsData = [
      "Preserve evidence immediately — screenshots, transaction IDs, phone numbers, and message timestamps.",
      "Call the 1930 helpline right away for financial fraud, or visit cybercrime.gov.in to file a complaint online.",
      "Choose the correct category (financial fraud, women/child safety, other cybercrime) so it routes to the right unit.",
      "Note your acknowledgement/complaint number and use it to track status.",
      "Also inform your bank or platform directly to freeze accounts or take down content."
    ];

    const checks = [
      {t:"Enable app locks", d:"Add a PIN or biometric lock to banking and messaging apps for a second layer of defence."},
      {t:"Back up important files", d:"Regular offline backups mean a ransomware attack costs you time, not everything."},
      {t:"Check app permissions", d:"Review what each app can access — camera, contacts, SMS — and revoke what it doesn't need."},
      {t:"Freeze unused cards/SIMs", d:"Deactivate accounts and SIM cards you no longer use so they can't be hijacked later."},
      {t:"Talk to family about scams", d:"Older and younger family members are frequent targets — share what these case files cover."},
      {t:"Report, don't just delete", d:"Reporting harassment or fraud helps authorities trace patterns, not just remove one message."},
    ];

    const studies = [
      {tag:"SCENARIO A · PHISHING", title:"The 'expired KYC' message", body:"A small-business owner received a text claiming their bank KYC had expired and needed re-verification via a link. The linked page looked identical to their bank's site. Within minutes of entering their net-banking password, ₹42,000 was transferred out.", lesson:"Lesson: Banks never ask you to 'reverify KYC' via an SMS link — always open the official app directly."},
      {tag:"SCENARIO B · RANSOMWARE", title:"The infected pen drive", body:"A small college office reused a personal pen drive across home and office systems. It carried ransomware that encrypted the admissions database overnight. No backup existed, and the ransom note demanded payment in cryptocurrency.", lesson:"Lesson: Never mix personal and institutional storage devices — and always keep an offline backup."},
      {tag:"SCENARIO C · CYBERBULLYING", title:"The morphed photo", body:"After a disagreement in a class group, a student's photo was digitally altered and shared to embarrass them, followed by anonymous threats. The student initially stayed silent out of fear, which allowed it to continue for weeks.", lesson:"Lesson: Reporting early — to platforms, teachers, or cybercrime.gov.in — stops escalation faster than silence does."},
    ];

    // ---------- RENDER ----------
    const fileGrid = document.getElementById('fileGrid');
    cases.forEach(c=>{
      const card = document.createElement('div');
      card.className='file-card';
      card.innerHTML = `
        <div class="file-top">
          <span class="file-num mono">${c.num}</span>
          <span class="threat ${c.threat==='CRITICAL'?'critical':c.threat==='HIGH'?'high':'medium'}">${c.threat}</span>
        </div>
        <div class="file-icon" aria-hidden="true">${c.icon}</div>
        <h3>${c.title}</h3>
        <p>${c.summary}</p>
        <div class="expand" hidden>
          <ul>${c.details.map(d=>`<li>${d}</li>`).join('')}</ul>
          <div class="scenario"><strong>Scenario:</strong> ${c.scenario}</div>
        </div>
        <button class="toggle-hint mono" aria-expanded="false" aria-controls="">+ open file</button>
      `;
      const expand = card.querySelector('.expand');
      const hintBtn = card.querySelector('.toggle-hint');
      hintBtn.setAttribute('aria-controls', expand.id || '');
      hintBtn.addEventListener('click', (e)=>{
        e.stopPropagation();
        const open = !card.classList.toggle('open');
        // Toggle using attribute and hidden for better accessibility
        const isOpen = !expand.hasAttribute('hidden');
        if (isOpen) {
          expand.setAttribute('hidden', '');
          hintBtn.textContent = '+ open file';
          hintBtn.setAttribute('aria-expanded', 'false');
        } else {
          expand.removeAttribute('hidden');
          hintBtn.textContent = '− close file';
          hintBtn.setAttribute('aria-expanded', 'true');
        }
      });
      // Also toggle by clicking the card (excluding the button)
      card.addEventListener('click', (e)=>{
        if (e.target.closest('.toggle-hint')) return;
        hintBtn.click();
      });
      fileGrid.appendChild(card);
    });

    const practiceGrid = document.getElementById('practiceGrid');
    practices.forEach(p=>{
      const el = document.createElement('div');
      el.className='practice-card';
      el.innerHTML = `<span class="n mono">${p.n}</span><h4>${p.title}</h4><p>${p.body}</p>`;
      practiceGrid.appendChild(el);
    });

    const lawList = document.getElementById('lawList');
    laws.forEach(l=>{
      const el = document.createElement('div');
      el.className='law-row';
      el.innerHTML = `<div class="law-code">${l.code}</div><div class="law-desc"><h4>${l.title}</h4><p>${l.body}</p></div>`;
      lawList.appendChild(el);
    });

    const stepsList = document.getElementById('stepsList');
    stepsData.forEach(s=>{
      const el = document.createElement('div');
      el.className='step';
      el.innerHTML = `<span class="num" aria-hidden="true"></span><p>${s}</p>`;
      stepsList.appendChild(el);
    });

    const checkGrid = document.getElementById('checkGrid');
    checks.forEach(c=>{
      const el = document.createElement('div');
      el.className='check-item';
      el.innerHTML = `<span class="mark" aria-hidden="true">✓</span><div><h4>${c.t}</h4><p>${c.d}</p></div>`;
      checkGrid.appendChild(el);
    });

    const studyList = document.getElementById('studyList');
    studies.forEach(s=>{
      const el = document.createElement('div');
      el.className='study';
      el.innerHTML = `<div class="tag mono">${s.tag}</div><div><h3>${s.title}</h3><p>${s.body}</p><span class="lesson">${s.lesson}</span></div>`;
      studyList.appendChild(el);
    });

    // ---------- NAV TOGGLE ----------
    const menuToggle = document.getElementById('menuToggle');
    const navLinks = document.getElementById('navLinks');
    menuToggle.addEventListener('click', ()=>{
      const open = navLinks.classList.toggle('open');
      menuToggle.setAttribute('aria-expanded', open);
    });
    navLinks.querySelectorAll('a').forEach(a=>a.addEventListener('click', ()=>{
      navLinks.classList.remove('open');
      menuToggle.setAttribute('aria-expanded', false);
    }));

    // ---------- REVEAL ON SCROLL ----------
    document.querySelectorAll('.section-head, .anatomy, .report-panel, .law-list').forEach(el=>el.classList.add('reveal'));
    const io = new IntersectionObserver((entries)=>{
      entries.forEach(e=>{ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} });
    },{threshold:0.12});
    document.querySelectorAll('.reveal').forEach(el=>io.observe(el));
  </script>

  <noscript>
    <style>
      .reveal{opacity:1; transform:none;}
    </style>
    <div style="padding:16px; background:#fff7cc; color:#333; text-align:center;">JavaScript is required for full interactivity (expand files, reveal animations). The content itself is still visible.</div>
  </noscript>
</body>
</html>
